<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.watermarks-remover.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/k/.venv/bin/python3</string>
        <string>/Users/k/.local/share/watermarks-remover/service/scripts/server.py</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8765</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/watermarks-remover.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/watermarks-remover.err</string>
    <key>WorkingDirectory</key>
    <string>/Users/k/.local/share/watermarks-remover</string>
</dict>
</plist>
